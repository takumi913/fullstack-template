SERVER_HOST=0.0.0.0
SERVER_PORT=1323

# sqlite 或 postgres
DB_DRIVER=sqlite
DB_PATH=app.db

# PostgreSQL
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=fullstack_template
# DB_SSLMODE=disable

SESSION_EXPIRE_HOUR=24
# 生产环境（HTTPS）必须设置为 true，否则会话 Cookie 可能被明文传输
COOKIE_SECURE=false

# 允许跨域的前端来源，逗号分隔
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# 可选：临时覆盖 site-config.ts 中的 home.primaryToolSlug
# VITE_HOME_PRIMARY_TOOL_SLUG=json-formatter

# 开启后，构建时禁止缺省/示例 canonical 域名和未清理的模板示例内容
SEO_STRICT=false

# 仅模板仓库 CI/测试使用；真实生产站不要开启
SEO_ALLOW_TEMPLATE_EXAMPLES=false

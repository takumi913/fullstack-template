VITE_API_BASE_URL=http://localhost:1323

# SEO / canonical / sitemap
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=Fullstack Template
VITE_SITE_SHORT_NAME=Fullstack
VITE_SITE_MARK=F
VITE_SITE_FAVICON=/favicon.svg
VITE_SITE_LOCALE=zh-CN
VITE_SITE_PRIMARY_KEYWORD=go react saas template
VITE_SITE_TITLE=Go + React 多租户 SaaS 全栈模板
VITE_SITE_DESCRIPTION=基于 Go、React、sqlc、PostgreSQL/SQLite 与多租户 RBAC 的 SaaS 全栈母模板。

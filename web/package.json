{
  "name": "fullstack-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "bun run seo:preflight && vite build && bun scripts/prerender.ts && bun run seo:generate && bun run seo:verify",
    "typecheck": "tsc -b",
    "seo:generate": "bun scripts/generate-seo-files.ts",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seo:verify": "bun scripts/verify-seo-build.ts",
    "seo:preflight": "bun scripts/seo-preflight.ts",
    "perf:ablation": "bun scripts/performance-ablation.mjs"
  },
  "dependencies": {
    "@lucide/solid": "1.61.0",
    "@solidjs/router": "2.0.0-next.41",
    "@solidjs/web": "2.0.0-rc.16",
    "@tailwindcss/vite": "^4.1.10",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "i18next": "^26.5.3",
    "solid-js": "2.0.0-rc.16",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "0.18.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

{
  "name": "fullstack-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && bun run seo:generate && bun run seo:verify",
    "typecheck": "react-router typegen && tsc -b",
    "seo:generate": "bun scripts/generate-seo-files.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seo:verify": "bun scripts/verify-seo-build.ts"
  },
  "dependencies": {
    "@react-router/node": "7.18.3",
    "@tailwindcss/vite": "^4.1.10",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "7.18.3",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "zustand": "^5.0.15",
    "isbot": "^5.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.18.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  }
}
